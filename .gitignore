# Dependencies
node_modules/

# Build output — produced by `npm run build`, host this but don't commit it
dist/

# Local dev copy of the database (see scripts/copy-db.mjs) — the real site
# loads the database from its configured URL at runtime, not this file
public/moistdb.sqlite

# Logs & OS cruft
*.log
.DS_Store

# Local secrets (Warcraft Logs API client for scripts/raids/)
.env.local
.env*.local

# Personal Claude Code permissions (the shared skill + launch config are committed)
.claude/settings.local.json
